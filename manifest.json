{
  "manifest_version": 3,
  "name": "Return Facebook Share Viewer",
  "version": "0.5.0",
  "description": "Re-enables the 'who shared your post' feature on your Facebook website.",
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://facebook.com/*",
        "*://web.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://facebook.com/*",
        "*://web.facebook.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "assets/icon.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "icons": {
    "128": "assets/icon.png"
  }
}